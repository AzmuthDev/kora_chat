# Copie para .env e preencha.

PORT=3000

# MySQL 8: mysql://usuario:senha@host:porta/banco (na nuvem, com ?ssl-mode=REQUIRED no final)
DATABASE_URL=
# Certificado CA do provedor (Aiven: "CA certificate" na página do serviço), salvo na pasta do projeto
DATABASE_SSL_CA=
# Preenchidos por: node scripts/setup-mysql.mjs (MySQL local para desenvolvimento e testes)
LOCAL_DATABASE_URL=
TEST_DATABASE_URL=

# Painel do app na Meta → Configurações do app → Básico → Chave secreta do aplicativo
META_APP_SECRET=
# Qualquer string; cole a mesma no campo "Verificar token" ao configurar o webhook na Meta
META_VERIFY_TOKEN=

# Protege /api/*. Mínimo 16 caracteres.
ADMIN_TOKEN=

# 64 caracteres hex. Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

IG_GRAPH_BASE_URL=https://graph.instagram.com
IG_GRAPH_VERSION=v24.0

# Login OAuth do Instagram (opcional; sem isso, só conexão manual por token).
# Painel do app → Instagram → Configurar API com login do Instagram → "ID do app do Instagram" e "Chave secreta do app do Instagram"
IG_APP_ID=
IG_APP_SECRET=
# URL pública HTTPS deste servidor. Cadastre PUBLIC_BASE_URL/oauth/instagram/callback como URI de redirecionamento no painel.
PUBLIC_BASE_URL=
# Renova o token de 60 dias quando faltarem menos que N dias (o token precisa ter pelo menos 24h).
IG_TOKEN_REFRESH_DAYS_BEFORE=15

# true quando há um proxy HTTPS na frente (Caddy, nginx, Cloudflare Tunnel): o cookie de login fica Secure
TRUST_PROXY=false

# inline = worker no mesmo processo; off = só HTTP
WORKER_MODE=inline
# Cadastro aberto pelo painel (cria login + empresa). false = novas pessoas só entram por convite
SIGNUP_ENABLED=true
# De quantos em quantos minutos o worker procura comentários que o webhook não entregou (0 desliga)
COMMENT_SWEEP_MINUTES=5
LOG_LEVEL=info
