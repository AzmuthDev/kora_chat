{
  "name": "manychat-clone",
  "version": "0.1.0",
  "private": true,
  "description": "MVP de automação Instagram: comentário → DM",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "reset-password": "tsx --env-file-if-exists=.env src/auth/reset-password-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:setup": "node scripts/setup-mysql.mjs"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
